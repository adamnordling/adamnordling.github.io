/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://api.github.com; frame-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'none';
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/manifest.webmanifest
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/manifest+json; charset=utf-8
  Access-Control-Allow-Origin: *

/robots.txt
  ! Cache-Control
  Cache-Control: public, max-age=86400

/sitemap.xml
  ! Cache-Control
  Cache-Control: public, max-age=86400
  Content-Type: application/xml; charset=utf-8

/
  Cache-Control: public, max-age=0, must-revalidate
  Cloudflare-CDN-Cache-Control: max-age=604800, stale-while-revalidate=86400